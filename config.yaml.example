# config.yaml.example — Copy to config.yaml and fill in your credentials.
#
# NEVER commit config.yaml — it contains secrets and is .gitignored.

mode: paper  # "paper" or "live"

exchange:
  name: binance
  testnet: false
  api_key: ""       # Binance API key
  api_secret: ""    # Binance API secret

symbols:
  - BTCUSDT
  - ETHUSDT
  - SOLUSDT
  - BNBUSDT

bar_size: "4h"

strategy:
  type: trend_following
  donchian_period: 20
  ema_fast: 9
  ema_slow: 21
  ema_confirm_bars: 5
  ema_trend: 50
  volume_period: 20
  atr_period: 14
  atr_stop_multiplier: 3.0
  adx_period: 14
  adx_threshold: 20.0
  volatility_low: 0.5
  volatility_high: 2.5
  chandelier_lookback: 10

  funding_filter:
    enabled: true
    extreme_threshold: 0.0005
    elevated_threshold: 0.0003
    size_reduction: 0.5
    poll_interval_seconds: 300

  partial_exits:
    enabled: true
    first_target_r: 3.0
    first_exit_pct: 0.25
    second_target_r: 6.0
    second_exit_pct: 0.25

  # Legacy v1 XGBoost ML filter — KEEP DISABLED (overfit)
  ml_filter:
    enabled: false
    url: "http://localhost:9001"
    threshold: 0.65
    timeout_ms: 200
    fail_open: false
    fallback_to_adx: true

  # Regime Classifier (Traffic Light) — SOL/ETH only have signal
  # Paper trade for 2-3 months before enabling
  regime_filter:
    enabled: false
    url: "http://localhost:9001"
    threshold: 0.50
    timeout_ms: 200
    fail_open: false
    fallback_to_adx: true

  # Dynamic Stop-Loss (Volatility Predictor) — production-ready for all symbols
  dynamic_stop:
    enabled: true
    url: "http://localhost:9001"
    timeout_ms: 200
    fail_open: true       # fallback to ATR if ML server fails
    k: 1.2                # slight overestimate → safer stops
    min_stop_pct: 0.01    # 1% floor
    max_stop_pct: 0.04    # 4% ceiling

risk:
  max_risk_per_trade_pct: 1.0
  max_daily_loss_pct: 3.0
  max_open_positions: 4
  max_leverage: 2.0
  initial_equity: 10000.0

execution:
  use_limit_orders: false
  slippage_bp: 5.0
  fee_percent: 0.04

monitoring:
  prometheus_port: 9090

alerts:
  telegram_bot_token: ""     # Telegram bot token from @BotFather
  telegram_chat_id: 0        # Your Telegram chat ID
  enable_telegram_commands: true # Set to true for the main bot instance, false for others to avoid duplicate responses

# Legacy ML settings (kept for backward compatibility, not used by trend_following)
sentiment:
  url: http://localhost:8000
  poll_interval_seconds: 60
  sentiment_threshold_long: 0.3
  sentiment_threshold_short: -0.3
  enabled: false
  schedule_times:
    - "08:00"
    - "16:00"
  use_database: true
  database_path: sentiment.db

model:
  path: ""
  runtime_lib_path: ""
  threshold_up: 0.6
  threshold_down: 0.6
  num_classes: 3
  timeframe: "4h"
