SENTIMENT_REDDIT_CLIENT_ID=your_reddit_client_id
SENTIMENT_REDDIT_CLIENT_SECRET=your_reddit_client_secret
SENTIMENT_REDDIT_USER_AGENT=quant-bot-sentiment/1.0

SENTIMENT_TWITTER_BEARER_TOKEN=your_twitter_bearer_token

SENTIMENT_COINGECKO_API_KEY=your_coingecko_api_key
SENTIMENT_CRYPTOPANIC_API_KEY=your_cryptopanic_api_key
SENTIMENT_NEWSAPI_KEY=your_newsapi_key

# New API keys for additional data sources
SENTIMENT_COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
SENTIMENT_MARKETAUX_API_KEY=your_marketaux_api_key
SENTIMENT_FINNHUB_API_KEY=your_finnhub_api_key
SENTIMENT_FMP_API_KEY=your_fmp_api_key

# Telegram API credentials (get from https://my.telegram.org/apps)
# Run setup_telegram.py to configure
SENTIMENT_TELEGRAM_API_ID=your_telegram_api_id
SENTIMENT_TELEGRAM_API_HASH=your_telegram_api_hash
SENTIMENT_TELEGRAM_SESSION_NAME=sentiment_bot
SENTIMENT_TELEGRAM_LISTENER_ENABLED=false

SENTIMENT_REDIS_URL=redis://localhost:6379
SENTIMENT_USE_REDIS=false

SENTIMENT_MODEL_NAME=ProsusAI/finbert
SENTIMENT_UPDATE_INTERVAL=60
SENTIMENT_HISTORY_HOURS=24
