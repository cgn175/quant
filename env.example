# =============================================================================
# Quant Bot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Exchange (Binance) ---
EXCHANGE_API_KEY=your-binance-api-key
EXCHANGE_API_SECRET=your-binance-api-secret

# --- Reddit (for sentiment service) ---
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# --- Twitter / X (for sentiment service, optional) ---
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# --- Telegram Alerts (optional) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Sentiment Service Config ---
# SENTIMENT_REDIS_URL=redis://localhost:6379
# SENTIMENT_USE_REDIS=false
# SENTIMENT_MODEL_NAME=ProsusAI/finbert
# SENTIMENT_SENTIMENT_UPDATE_INTERVAL=60
